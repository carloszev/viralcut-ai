{
  "name": "probando-un-app",
  "version": "1.1.0",
  "description": "ViralCut AI - Automated Viral Video Repurposing Engine",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "tsx watch --exclude \"data/**\" --exclude \"exports/**\" --exclude \"uploads/**\" --exclude \"**/*.mp4\" --exclude \"**/*.part\" --exclude \"**/*.tmp*\" server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "app": "electron electron/main.cjs",
    "pack": "electron-builder --dir",
    "build:iso": "powershell -ExecutionPolicy Bypass -File scripts/build-iso.ps1",
    "preview": "vite preview",
    "test": "tsx server/test/system.test.ts && tsx server/test/aiFeatures.test.ts && tsx server/test/superFeatures.test.ts",
    "test:chaos": "tsx server/test/chaos.test.ts"
  },
  "build": {
    "appId": "com.viralcut.ai",
    "productName": "ViralCut AI",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "server/**/*",
      "data/**/*",
      "package.json"
    ],
    "asar": false
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "youtube-sr": "^4.3.12",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
