# =================================================================
# ViralCut AI — Environment Configuration
# =================================================================

# Server Port (Default: 4000)
PORT=4000

# Environment Mode: development | production
NODE_ENV=development

# Optional: Google Gemini API Key for enhanced LLM content analysis
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenAI API Key for Whisper / GPT-4o analysis
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
